@startuml
skinparam linetype ortho
skinparam nodesep 40
skinparam ranksep 40
skinparam pathHoverColor green
hide empty description

  state "Is the cumulative ultimate equity detention by \nFinancial Sponsors above 40%?" as Q01 {
    state "Yes" as Q01_YES
    state "No" as Q01_NO
  }

  state "Status of the counterparty" as Q_S01 {
    state "Utimate Mother Company" as UMC
    state "Subsidiary" as SUBSIDIARY
  }

  state "Is there a supporting entity \n(mother company or another legal entity) as per the \nsupport entity definition provided \nin the applicable rating policies?" as Q_S02 {
    state "Yes" as Q_S02_YES
    state "No" as Q_S02_NO
  }

  state "Parent Company" as Q_S05 {
    Q_S05: RMPMID - <reference entity name>
  }

  state "Counterparty on which the FED leverage\n ratio is calculated (ie Parent or \n exceptionally on another Legal Entity)" as Q_S06 {
    Q_S06: RMPMID - <reference entity name>
  }

  state "Level of leveraged calculation" as Q_S04_BUSINESS_GROUP_1 {
    Q_S04_BUSINESS_GROUP_1: Business Group Level
  }

  state "Level of leveraged calculation" as Q_S04_BUSINESS_GROUP_2 {
    Q_S04_BUSINESS_GROUP_2: Business Group Level
  }

  state "Level of leveraged calculation" as Q_S04_BORROWER {
    Q_S04_BORROWER: Borrower Level
  }

  state "Main Industry" as Q_MI_01 {
    state "General Obligor" as GENERAL_OBLIGOR
    state "Utilities" as UTILITIES
