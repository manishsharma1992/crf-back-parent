    | Gross Debt | Threshold per policy based on Sector | raThresholdPerPolicyBasedOnSector | string | Yes | Yes | No | | just display x4 |
  end note
  

  state "Escalation tests for Highly Leveraged Transactions\nIs the current level of delegation of the file\n just below the CCDG threshold? (ie: Level 6 for CIB)" as Q_E01 {
    state "Yes" as Q_E01_YES
    state "No" as Q_E01_NO
  }

  state "Rule for escalation to CCDG\nIs the repayment Test interrupted?" as Q_E02 {
    state "Yes" as Q_E02_YES
    state "No" as Q_E02_NO
  }

  state "If Leveraged, Escalate?" as Q_E03 {
    Q_E03: Yes / No / empty  (computed)
  }

  [*] --> Q01
  Q01_YES --> Q_S01
  Q01_NO --> Q_S01
  UMC --> Q_S04_BUSINESS_GROUP_2
  SUBSIDIARY --> Q_S02
  Q_S02_YES --> Q_S04_BUSINESS_GROUP_1
  Q_S02_NO --> Q_S04_BORROWER
  Q_S04_BUSINESS_GROUP_1 --> Q_S05
  Q_S05 --> Q_S06
  Q_S06 --> [*]
  Q_S04_BUSINESS_GROUP_2 --> Q_MI_01
  Q_S04_BORROWER --> Q_MI_01
  GENERAL_OBLIGOR --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_1
  UTILITIES --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_1
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_1 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_2
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_1 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_2
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_2 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_3
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_2 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_3
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_3 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_4
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_3 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_4
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_4 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_5
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_4 --> GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_5
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_5 --> GENERAL_OBLIGOR_AND_UTILITIES_FINANCIAL_TABLE_1
  GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_5 --> GENERAL_OBLIGOR_AND_UTILITIES_FINANCIAL_TABLE_1
  GENERAL_OBLIGOR_AND_UTILITIES_FINANCIAL_TABLE_1 --> Q_E01 : [escalation tests apply]
  GENERAL_OBLIGOR_AND_UTILITIES_FINANCIAL_TABLE_1 --> Q_E03 : [tests hidden:\n ceFedLeverageRatio = NA, or\n 0 < ceFedLeverageRatio < escalationThreshold]
  Q_E01_YES --> Q_E02
  Q_E01_NO --> Q_E03
  Q_E02_YES --> Q_E03
  Q_E02_NO --> Q_E03
