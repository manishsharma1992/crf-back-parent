  state "Is highly secured debt 100% of the \nBorrower/Business Group's Total Debt \nStructure?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_1 {
    state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_1
    state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_1
  }

  state "Is the bank's only exposure through a\n High Secured Debt tranche?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_2 {
    state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_2
    state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_2
  }

  state "Does the obligor carries an investment \ngrade internal credit rating?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_3 {
