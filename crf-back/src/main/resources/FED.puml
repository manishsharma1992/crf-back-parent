    state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_3
  }

  state "Is the borrower a subsidiary of an \ninvestment grade business group or benefits from\n guarantees and/or the support of an\n investment grade party or sovereign entity?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_4 {
    state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_4
    state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_4
  }

