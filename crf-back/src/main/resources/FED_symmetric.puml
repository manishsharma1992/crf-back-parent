@startuml
skinparam linetype ortho
skinparam nodesep 50
skinparam ranksep 55
skinparam pathHoverColor green
hide empty description
top to bottom direction


    state "Is the cumulative ultimate equity detention by \nFinancial Sponsors above 40%?" as Q01 {
        Q01: If user clicked save button without answering this mandatory question, then we need to display blocking error \n "FED Form - The question "Is the cumulative ultimate equity detention by Financial Sponsors above 40%?" is mandatory"
        state "Yes" as Q01_YES
        state "No" as Q01_NO
      }

    state "**Preliminary Question for FED Form**" as PRELIMINARY {
          state "Status of the counterparty" as Q_S01 {
            Q_S01: If user clicked save button without answering this mandatory question, then we need to display blocking error \n "FED Form - The question "Status of the Counterparty" is mandatory"
            state "Ultimate Mother Company" as UMC
            state "Subsidiary" as SUBSIDIARY
          }

          state "Is there a supporting entity \n(mother company or another legal entity) as per the \n support entity definition provided \nin the applicable rating policies?" as Q_S02 {
            Q_S02: If user clicked save button without answering this mandatory question, then we need to display blocking error \n "FED Form - The question "Is there a support from the parent company as per the Support Entity definition provided in the applicable rating policies?" is mandatory"
            state "Yes" as Q_S02_YES
            state "No" as Q_S02_NO
          }

          state "Parent Company" as Q_S05 {
            Q_S05: RMPMID - <reference entity name>
          }

          state "Counterparty on which the FED leverage\n ratio is calculated (ie Parent or \n exceptionally on another Legal Entity)" as Q_S06 {
            Q_S06 : RMPMID - <reference entity name>, need to have same errors as ECB Form
          }

          state "Level of leveraged calculation" as Q_S04_BUSINESS_GROUP_1 {
            Q_S04_BUSINESS_GROUP_1: Business Group Level
          }

          state "Level of leveraged calculation" as Q_S04_BUSINESS_GROUP_2 {
            Q_S04_BUSINESS_GROUP_2: Business Group Level
          }

          state "Level of leveraged calculation" as Q_S04_BORROWER {
            Q_S04_BORROWER: Borrower Level
          }

          state "Main Industry" as Q_MI_01 {
            Q_MI_01: If user clicked save button without answering this mandatory question, then we need to display blocking error \n "FED Form - The question "Main Industry" is mandatory"
            state "General Obligor" as GENERAL_OBLIGOR
            state "Utilities" as UTILITIES
            state "Project Finance" as PROJECT_FINANCE
            state "Aviation Portfolio\n Leasing Company" as APLC
            state "Real Estate\n Investment Trusts\n (REITs)" as REIT
            state "Others" as OTHERS
          }
    }

    state "**General Obligor / Utilities**" as GENERAL_OBLIGOR_OR_UTILITIES_PATH {
      state "Is highly secured debt 100% of the \nBorrower/Business Group's Total Debt \nStructure?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_1 {
        state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_1
        state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_1
      }

      state "Is the bank's only exposure through a\n High Secured Debt tranche?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_2 {
        state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_2
        state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_2
      }

      state "Does the obligor carries an investment \n grade internal credit rating?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_3 {
        state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_3
        state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_3
      }

      state "Is the borrower a subsidiary of an \n investment grade business group or benefits from\n guarantees and/or the support of an\n investment grade party or sovereign entity?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_4 {
        state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_4
        state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_4
      }

      state "Is obligor WL/DD?" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_QUESTION_5 {
        state "Yes" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_YES_5
        state "No" as GENERAL_OBLIGOR_AND_UTILITIES_PATH_NO_5
      }

      note as GENERAL_OBLIGOR_AND_UTILITIES_FINANCIAL_TABLE_1
        **Financial Table**
        Leverage Loan Test at Credit Event / Data At Credit Event (for leverage and escalation test)

        <#E8F1FB,#1D4E89>|= Section |= Label |= Field Key |= Type |= Mandatory |= Visible |= Editable|= Derived From |= Business rule |
        | Origination Date | At origination Date | goCeOriginationDate | Date | Yes | Yes | Yes | | to be manually filled by user |
        | Ebitda | Accounting EBITDA | goCeAccountingEbitda | BigDecimal | Yes | Yes | Yes | FINANCIALS/ebitda | Get EBITDA from financial table / numeric / editable |
        | Ebitda | Adjustment 1 (wording in comment) | goCeAdjustment1 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 2 (wording in comment) | goCeAdjustment2 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 3 (wording in comment) | goCeAdjustment3 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 4 (wording in comment) | goCeAdjustment4 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 5 (wording in comment) | goCeAdjustment5 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 6 (wording in comment) | goCeAdjustment6 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 7 (wording in comment) | goCeAdjustment7 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 8 (wording in comment) | goCeAdjustment8 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        |<#DBEAFE> Ebitda |<#DBEAFE> **Adjusted EBITDA** |<#DBEAFE> goCeAdjustedEbitda |<#DBEAFE> BigDecimal |<#DBEAFE> Yes |<#DBEAFE> Yes |<#DBEAFE> No |<#DBEAFE> CALC/goCeAdjustedEbitda |<#DBEAFE> goCeAccountingEbitda + goCeAdjustment1..goCeAdjustment8 \n If empty, null or equal to 0: **"FED Form - The Adjusted EBITDA is missing, please insert its value"** |
        | Gross Debt | Committed Loan Facility | goCeCommittedLoanFacility | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | Committed LC Facility | goCeCommittedLCFacility | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | Funded debt on \nuncommitted loan facilities | goCeFundedDebtOnUncommittedLoanFacilities | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | Outstanding amounts on \nuncommitted LC facilities | goCeOutstandingAmountsOnUncommittedLCFacilities | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | Other Financial Commitments | goCeOtherFinancialCommitments | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        |<#DBEAFE> Gross Debt |<#DBEAFE> **Total Committed Debt** |<#DBEAFE> goCeTotalCommittedDebt |<#DBEAFE> BigDecimal |<#DBEAFE> No |<#DBEAFE> Yes |<#DBEAFE> No |<#DBEAFE> CALC/goCeTotalCommittedDebt |<#DBEAFE> loan + LC + uncommitted loan + uncommitted LC + other |
        | Gross Debt | o/w Non recourse debt | goCeNonRecourseDebt | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | o/w Qualifying Subordinated Debt | goCeQualifyingSubordinatedDebt | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        |<#DBEAFE> Gross Debt |<#DBEAFE> **Total Committed Debt Per Definition** |<#DBEAFE> goCeTotalCommittedDebtPerDefinition |<#DBEAFE> BigDecimal |<#DBEAFE> Yes |<#DBEAFE> Yes |<#DBEAFE> No |<#DBEAFE> CALC/goCeTotalCommittedDebtPerDefinition |<#DBEAFE> goCeTotalCommittedDebt - goCeNonRecourseDebt - goCeQualifyingSubordinatedDebt |
        |<#DBEAFE> Gross Debt |<#DBEAFE> **Total Committed Debt Per Definition / Adj. EBITDA** \n **(FED leverage ratio)** |<#DBEAFE> goCeFedLeverageRatio |<#DBEAFE> BigDecimal |<#DBEAFE> Yes |<#DBEAFE> Yes |<#DBEAFE> No |<#DBEAFE> CALC/goCeFedLeverageRatio |<#DBEAFE> goCeTotalCommittedDebtPerDefinition / goCeAdjustedEbitda  [fillsFlag: fedLeverageRatio] |
        | Gross Debt | Threshold per policy based on Sector | goCeThresholdPerPolicyBasedOnSector | string | Yes | Yes | No | | display x4 if Q_MI_01 = General Obligor; display x6 if Q_MI_01 = Utilities |
        | Gross Debt | Threshold for Escalation | goCeEscalationThreshold | BigDecimal | Yes | Yes | No | | display x6; display x7 if Q-MI01 = Utilities |
      end note

      note as GENERAL_OBLIGOR_AND_UTILITIES_FINANCIAL_TABLE_2
        **Financial Table**
        Low / Risk Assessment: done at Credit Event and each AR / LTM Data for high/low risk decision)

        <#E8F1FB,#1D4E89>|= Section |= Label |= Field Key |= Type |= Mandatory |= Visible |= Editable|= Derived From |= Business rule |
        | Origination Date | At origination Date | goRaOriginationDate | Date | Yes | Yes | Yes | | to be manually filled by user |
        | Ebitda | Accounting EBITDA | goRaAccountingEbitda | BigDecimal | Yes | Yes | Yes | FINANCIALS/ebitda | Get EBITDA from financial table / numeric / editable |
        | Ebitda | Adjustment 1 (wording in comment) | goRaAdjustment1 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 2 (wording in comment) | goRaAdjustment2 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 3 (wording in comment) | goRaAdjustment3 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 4 (wording in comment) | goRaAdjustment4 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 5 (wording in comment) | goRaAdjustment5 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 6 (wording in comment) | goRaAdjustment6 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 7 (wording in comment) | goRaAdjustment7 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Ebitda | Adjustment 8 (wording in comment) | goRaAdjustment8 | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        |<#DBEAFE> Ebitda |<#DBEAFE> **Adjusted EBITDA** |<#DBEAFE> goRaAdjustedEbitda |<#DBEAFE> BigDecimal |<#DBEAFE> Yes |<#DBEAFE> Yes |<#DBEAFE> No |<#DBEAFE> CALC/goRaAdjustedEbitda |<#DBEAFE> goRaAccountingEbitda + goRaAdjustment1..goRaAdjustment8 \n If empty, null or equal to 0: **"FED Form - The Adjusted EBITDA is missing, please insert its value"** |
        | Gross Debt | Total B/S debt | goRaTotalBSDebt | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | Non recourse Debt | goRaNonRecourseDebt | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | Highly Secured \n Portion of Gross Funded Debt | goRaHighlySecuredGrossFundedDebt | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | Gross Debt | Qualifying Funded \nSubordinated Debt | goRaQualifyingFundedSubordinatedDebt | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | <#DBEAFE> Gross Debt | <#DBEAFE> **Adj. Gross Funded Total Debt** | <#DBEAFE> goRaAdjustedGrossFundedTotalDebt | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/goRaAdjustedGrossFundedTotalDebt | <#DBEAFE> goRaTotalBSDebt - goRaNonRecourseDebt \n - goRaHighlySecuredGrossFundedDebt - goRaQualifyingFundedSubordinatedDebt |
        | Gross Debt | Cash | goRaCash | BigDecimal | No | Yes | Yes | | Numeric value to be inserted |
        | <#DBEAFE> Gross Debt | <#DBEAFE> **Adj. Net Funded Total Debt** | <#DBEAFE> goRaAdjustedFundedTotalDebt | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/goRaAdjustedFundedTotalDebt | <#DBEAFE> goRaAdjustedGrossFundedTotalDebt - goRaCash |
        | <#DBEAFE> Gross Debt | <#DBEAFE> **Adj. Net Funded Total Debt / Adj. EBITDA** | <#DBEAFE> goRaFedLeverageRatio | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/goRaFedLeverageRatio | <#DBEAFE> ceTotalCommittedDebtPerDefinition (Table 1) / goRaAdjustedEbitda |
        | Gross Debt | Threshold per policy based on Sector | goRaThresholdPerPolicyBasedOnSector | string | Yes | Yes | No | | just display x4 |
      end note


      state "Escalation tests for Highly Leveraged Transactions\nIs the current level of delegation of the file\n just below the CCDG threshold? (ie: Level 6 for CIB)" as Q_E01 {
        state "Yes" as Q_E01_YES
        state "No" as Q_E01_NO
      }

      state "Rule for escalation to CCDG \n Is the repayment Test interrupted?" as Q_E02 {
        state "Yes" as Q_E02_YES
        state "No" as Q_E02_NO
      }

      state "If Leveraged, Escalate?" as Q_E03 {
        Q_E03: Yes / No / empty  (computed)
      }
  }

  state "**Project Finance**" as PROJECT_FINANCE_PATH {
    state "Date of the latest Fiscal Quarter End" as PROJECT_FINANCE_PATH_Q01 {
        PROJECT_FINANCE_PATH_Q01: Date Input
      }

      state "Is obligor Leveraged?" as PROJECT_FINANCE_PATH_Q02 {
        state "Yes" as PROJECT_FINANCE_PATH_Q02_YES
        state "No" as PROJECT_FINANCE_PATH_Q02_NO
      }

      state "Is obligor WL/DD?" as PROJECT_FINANCE_PATH_Q03_A {
        state "Yes" as PROJECT_FINANCE_PATH_Q03_A_YES
        state "No" as PROJECT_FINANCE_PATH_Q03_A_NO
      }

      state "Is obligor WL/DD?" as PROJECT_FINANCE_PATH_Q03_B {
        state "Yes" as PROJECT_FINANCE_PATH_Q03_B_YES
        state "No" as PROJECT_FINANCE_PATH_Q03_B_NO
      }

      state "High or Low Risk" as PROJECT_FINANCE_Q04 {
        PROJECT_FINANCE_Q04: High
      }

      state "Transaction Type" as PROJECT_FINANCE_PATH_Q05 {
        state "Debt Service" as PROJECT_FINANCE_PATH_Q05_DEBT_SERVICE
        state "Cash Flow Recapture" as PROJECT_FINANCE_PATH_Q05_CASH_FLOW_RECAPTURE
        state "Bullet Transaction" as PROJECT_FINANCE_PATH_Q05_BULLET_TRANSACTION
      }

      state "Project Type" as PROJECT_FINANCE_PATH_Q06 {
        state "General Project Obligor / Power" as PROJECT_FINANCE_PATH_Q06_GPOP
        state "Infrastructure / Tool Roads" as PROJECT_FINANCE_PATH_Q06_ITR
        state "Power Assets" as PROJECT_FINANCE_PATH_Q06_PA
      }

      state "Project Finance Leveraged lending Assessment" as PROJECT_FINANCE_PATH_Q07 {
        PROJECT_FINANCE_PATH_Q07: Comment input field (TEXTAREA)
      }

      state "High or Low Risk" as PROJECT_FINANCE_Q08 {
        state "High" as PROJECT_FINANCE_Q08_HIGH
        state "Low" as PROJECT_FINANCE_Q08_LOW
      }
  }

  state "**Aviation Portfolio Leasing Company**" as APLC_PATH {
    state "Date of the latest Fiscal Quarter End" as APLC_PATH_Q01 {
        APLC_PATH_Q01: Date Input
      }

      state "Is highly secured debt 100% of the \nBorrower/Business Group's Total Debt \nStructure?" as APLC_PATH_Q02 {
        state "Yes" as APLC_PATH_Q02_YES
        state "No" as APLC_PATH_Q02_NO
      }

      state "Is the bank's only exposure through a\n High Secured Debt tranche?" as APLC_PATH_Q03 {
        state "Yes" as APLC_PATH_Q03_YES
        state "No" as APLC_PATH_Q03_NO
      }

      state "Does the obligor carries an investment \ngrade internal credit rating?" as APLC_PATH_Q04 {
        state "Yes" as APLC_PATH_Q04_YES
        state "No" as APLC_PATH_Q04_NO
      }

      state "Is the borrower a subsidiary of an \ninvestment grade business group or benefits from\n guarantees and/or the support of an\n investment grade party or sovereign entity?" as APLC_PATH_Q05 {
        state "Yes" as APLC_PATH_Q05_YES
        state "No" as APLC_PATH_Q05_NO
      }

      state "Is obligor WL/DD?" as APLC_PATH_Q06 {
        state "Yes" as APLC_PATH_Q06_YES
        state "No" as APLC_PATH_Q06_NO
      }

      note as APLC_FINANCIAL_TABLE
        **Financial Table**
        Leveraged Loan Test at Credit Event / Data At Credit Event (for leverage and escalation test)

        <#E8F1FB,#1D4E89>|= Section |= Label |= Field Key |= Type |= Mandatory |= Visible |= Editable|= Derived From |= Business rule |
        | Funded Debts | Total B/S Debt | aplcTotalBSDebt | BigDecimal | No | Yes | Yes| FINANCIALS/gross_debt | Retrieved from financial table and remains editable |
        | Funded Debts | Non recourse debt | aplcNonRecourseDebt | BigDecimal | No | Yes | Yes | | Numeric Value to be inserted by user |
        | Funded Debts | Highly Secured Portion of Gross Debt | aplcHighlySecuredPortionGrossDebt | BigDecimal | No | Yes | Yes | | Numeric Value to be inserted by user |
        | Funded Debts | Qualifying Funded Subordinated Debt | aplcQualifyingFundedSubordinatedDebt | BigDecimal | No | Yes | Yes | | Numeric Value to be inserted by user |
        | <#DBEAFE> Funded Debts | <#DBEAFE> **Applicable Funded Debt** | <#DBEAFE> aplcApplicableFundedDebt | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/aplcApplicableFundedDebt | <#DBEAFE> aplcApplicableFundedDebt = aplcTotalBSDebt - \n(aplcNonRecourseDebt \n+ aplcHighlySecuredPortionGrossDebt \n+ aplcQualifyingFundedSubordinatedDebt) |
        | Funded Debts | Book Value of Equity | aplcBookValueOfEquity | BigDecimal | Yes | Yes | Yes | FINANCIALS/total_equity | Retrieved from financials table total_equity, \nremains editable, \nif empty or equal to 0 an error message should be displayed\n **"The book value of equity is missing, please insert its value"** |
        | Funded Debts | Equity Held within SPVs| aplcEquityHeldSPVs | BigDecimal | No | Yes | Yes | | Numeric Value to be inserted by user |
        | <#DBEAFE> Funded Debts | <#DBEAFE> **Adjusted Book Value of Equity** | <#DBEAFE> aplcAdjustedBookValueOfEquity  | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes| <#DBEAFE> No | <#DBEAFE> CALC/aplcAdjustedBookValueOfEquity | <#DBEAFE> aplcAdjustedBookValueOfEquity = aplcBookValueOfEquity - aplcEquityHeldSPVs \n If empty of equal to 0, an error message should be displayed\n "**The Adjusted Book Value of equity amount is missing, please insert its value**" |
        | Funded Debts | Implied Debt-to-Equity of\n non-recourse subsidiary, \n when equity held with SPVs not known | aplcImpliedDebtToEquity | BigDecimal | Yes | Yes | No | | Set to string "4x", but value is 4 as constant |
        | <#DBEAFE> Funded Debts | <#DBEAFE> **Debt/Equity** | <#DBEAFE> aplcDebtToEquityRatio | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/aplcDebtToEquityRatio | <#DBEAFE> aplcDebtToEquityRatio = aplcApplicableFundedDebt / aplcAdjustedBookValueOfEquity |
        | Funded Debts | Debt to Equity Leverage Threshold | aplcDebtToEquityLeverageThreshold | BigDecimal | Yes | Yes | No | | Constant to 5, but displayed as 5x on UI |

        Escalation
        <#E8F1FB,#1D4E89>|= Section |= Label |= Field Key |= Type |= Mandatory |= Visible |= Editable|= Derived From |= Business rule |
        | Escalation | Debt to Equity escalation threshold | aplcDebtToEquityEscalationThreshold | BigDecimal | Yes | Yes | No | | Constant to 6.5, but displayed as 6.5x on UI |
      end note

      state "If Leveraged, Escalate?" as APLC_PATH_Q07 {
              APLC_PATH_Q07: Yes / No / empty  (computed)
      }

      state "Comment" as APLC_PATH_Q08 {
              APLC_PATH_Q08: Comment input field (TEXTAREA)
      }
  }

  state "**Real Estate Investment Trusts (REITs)**" as REIT_PATH {

    state "Date of the latest Fiscal Quarter End" as REIT_PATH_Q01 {
        REIT_PATH_Q01: Date Input
    }

    state "Is the transaction a secured real estate transaction?" as REIT_PATH_Q02 {
        state "Yes" as REIT_PATH_Q02_YES
        state "No" as REIT_PATH_Q02_NO
    }

    state "Is the transaction through direct lending or through an SPV?" as REIT_PATH_Q03_A {
        REIT_PATH_Q03_A: COMPUTED. Reached when REIT_PATH_Q02 = No.\nOption code NOT_APPLICABLE, EN and FR label "/".\n(A code, not a literal "/": codes survive re-import and locale changes.)
    }

    state "Is the transaction through direct lending or through an SPV?" as REIT_PATH_Q03_B {
        state "SPV" as REIT_PATH_Q03_B_SPV
        state "Lending" as REIT_PATH_Q03_B_DIRECT_LENDING
    }

    state "Is the bank's only exposure through a\n High Secured Debt tranche?" as REIT_PATH_Q04 {
        state "Yes" as REIT_PATH_Q04_YES
        state "No" as REIT_PATH_Q04_NO
    }

    state "Does the obligor carries an investment \n grade internal credit rating?" as REIT_PATH_Q05 {
        state "Yes" as REIT_PATH_Q05_YES
        state "No" as REIT_PATH_Q05_NO
    }

    state "BNPP Counterparty Rating" as BNPP_COUNTERPARTY_RATING {
        BNPP_COUNTERPARTY_RATING: this is a derivedFrom question, \n where we have to COUNTERPARTY_CHARACTERISTICS/BNPP_COUNTERPARTY_RATING\n we need fetch the columns rating and rating_date from counterparty_characteristics table
    }

    state "S&P Issuer Rating" as SP_ISSUER_RATING {
        SP_ISSUER_RATING: this is a derivedFrom question, \n where we have to COUNTERPARTY_CHARACTERISTICS/SP_ISSUER_RATING \n, we again have to go to counterparty_characteristics table and fetch data from column sp_issuer_rating and sp_issuer_rating_date
    }

    state "Moody's Issue Rating" as MOODYS_ISSUER_RATING {
        MOODYS_ISSUER_RATING: this is a derivedFrom question \n where we have to COUNTERPARTY_CHARACTERISTICS\MOODYS_ISSUER_RATING \n, we again have to go to counterparty_characteristics table and fetch data from column moodys_issuer_rating and moodys_issuer_rating_date
    }

    state "Is the borrower a subsidiary of an \n investment grade business group or benefits from\n guarantees and/or the support of an\n investment grade party or sovereign entity?" as REIT_PATH_Q06 {
        state "Yes" as REIT_PATH_Q06_YES
        state "No" as REIT_PATH_Q06_NO
    }

    state "Is obligor WL/DD?" as REIT_PATH_Q07 {
        state "Yes" as REIT_PATH_Q07_YES
        state "No" as REIT_PATH_Q07_NO
    }

    note as REIT_FINANCIAL_TABLE
    **Financial Table**
    Leveraged Loan at Credit Event / Data at Credit Event (for leverage and escalation test)

    <#E8F1FB,#1D4E89>|= Section |= Label |= Field Key |= Type |= Mandatory |= Visible |= Editable|= Derived From |= Business rule |
    | Origination Date | At origination Date | reitOriginationDate | Date | Yes | Yes | Yes | | to be manually filled by user |
    | Gross Debt | Commited Loan Facility | reitCommittedLoanFacility | BigDecimal | No | Yes | Yes | | to be manually field by user |
    | Gross Debt | Commited LC Facility | reitCommittedLCFacility | BigDecimal | No | Yes | Yes | | to be manually field by user |
    | Gross Debt | Funded debt on \n uncommitted loan facilities | reitFundedDebtOnUncommittedLoanFacilities | BigDecimal | No | Yes | Yes | | to be manually field by user |
    | Gross Debt | Outstanding amounts on \n uncommitted LC facilities | reitOutstandingAmountsOnUncommittedLCFacilities | BigDecimal | No | Yes | Yes | | to be manually field by user |
    | Gross Debt | Other Financial Commitments | reitOtherFinancialCommitments | BigDecimal | No | Yes | Yes | | to be manually field by user |
    | <#DBEAFE> Gross Debt | <#DBEAFE> **Total Committed Debt** | <#DBEAFE> reitTotalCommittedDebt | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/reitTotalCommittedDebt | <#DBEAFE> reitTotalCommittedDebt = reitCommittedLoanFacility + reitCommittedLCFacility \n + reitFundedDebtOnUncommittedLoanFacilities + reitOutstandingAmountsOnUncommittedLCFacilities \n + reitOtherFinancialCommitments |
    | Gross Debt | Non recourse debt | reitNonRecourseDebt | BigDecimal | No | Yes | Yes | | to be manually field by user |
    | Gross Debt | Qualifying Subordinated Debt | reitQualifyingSubordinatedDebt | BigDecimal | No | Yes | Yes | | to be manually field by user |
    | <#DBEAFE> Gross Debt | <#DBEAFE> **Total Committed Debt Per Definition** | <#DBEAFE> reitTotalCommittedDebtPerDefinition | <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/reitTotalCommittedDebtPerDefinition | <#DBEAFE> reitTotalCommittedDebtPerDefinition = reitTotalCommittedDebt - reitNonRecourseDebt - reitQualifyingSubordinatedDebt \n If empty or equal to 0: **"FED Form - The Total Committed Debt Per Definition amount is missing, please insert its value"** |
    | Gross Debt | Highly Secured Portion of \n Committed Total Debt | reitHighlySecuredPortionCommittedTotalDebt | BigDecimal | Yes | Yes | Yes | | to be manually filled by user. If empty or equal to 0: \n **"FED Form - Highly Secured Portion of Committed Total Debt amount is missing, please insert its value"** |
    | <#DBEAFE> Gross Debt | <#DBEAFE> % Highly Secured Portion of \n Total Committed Debt | <#DBEAFE> reitPctHighlySecuredPortionCommittedTotalDebt| <#DBEAFE> BigDecimal | <#DBEAFE> Yes | <#DBEAFE> Yes | <#DBEAFE> No | <#DBEAFE> CALC/reitPctHighlySecuredPortionCommittedTotalDebt | <#DBEAFE> reitPctHighlySecuredPortionCommittedTotalDebt = \n reitHighlySecuredPortionCommittedTotalDebt / reitTotalCommittedDebtPerDefinition |
    | Gross Debt | Threshold For Exclusion \n of Highly Secured Debt | reitThresholdForExclusionOfHighlySecuredDebt| BigDecimal | Yes | Yes | No | | the value is constant and set at 60% (shown on UI) |
    | Gross Debt | Carve Out Highly Secured Debt | reitCarveOutHighlySecuredDebt | Code (YES/NO) | Yes | Yes | No | | its a computed field, we need to check \n if reitPctHighlySecuredPortionCommittedTotalDebt < reitThresholdForExclusionOfHighlySecuredDebt then no, else yes |
    | Gross Debt | Adjusted Total Committed Debt | reitAdjustedTotalCommittedDebt | BigDecimal | Yes | Yes | No | | its a computed field, \n if reitCarveOutHighlySecuredDebt is answered no, then reitAdjustedTotalCommittedDebt = reitTotalCommittedDebtPerDefinition \n else reitAdjustedTotalCommittedDebt = (reitTotalCommittedDebtPerDefinition - reitHighlySecuredPortionCommittedTotalDebt) |
    | Net Operating Income | Net Operating Income | reitNetOperatingIncome | BigDecimal | Yes | Yes | Yes | | Numeric value to be inserted - If empty, an error message should be displayed: "FED Form - Net Operating Income amount is missing , please insert its value"|
    | Net Operating Income | Net Operating Income / Total Debt | reitCommittedDebtYield | BigDecimal | No | Yes | No | CALC/reitCommittedDebtYield | reitCommittedDebtYield = reitNetOperatingIncome / reitAdjustedTotalCommittedDebt |
    | Net Operating Income | Market Capitalization | reitMarketCapitalization | BigDecimal | Yes | Yes | Yes | | numeric value to be inserted by user |
    | Net Operating Income | Debt / Market Value Assets | reitDebtToMarketCap | BigDecimal | No | Yes | No | CALC/reitDebtToMarketCap | reitDebtToMarketCap = reitAdjustedTotalCommittedDebt \n / (reitAdjustedTotalCommittedDebt + reitMarketCapitalization); \n denominator may be 0 -> return nothing silently |
    | Net Operating Income | Committed Debt Yield Threshold | reitCommittedDebtYieldThreshold | BigDecimal | Yes | Yes | No | | its a constant value shown 8% always on the UI |
    | Net Operating Income | Debt to Market Value Assets Leverage Threshold | reitDebtToMarketValueAssetsLeverageThreshold |BigDecimal | Yes | Yes | No | | its a constant value shown 85% on the (shown on UI) |
    end note

