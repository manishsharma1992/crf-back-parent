                :fedLeveragedFlag =\nFED Leveraged Low Risk;
              else (no)
                if (goRaAdjustedEbitda < 0\nAND goRaAdjustedFundedTotalDebt < 0) then (yes)
                  :fedLeveragedFlag =\nFED Leveraged Low Risk;
                else (no)
                  if (goRaAdjustedEbitda < 0) then (yes)
                    :fedLeveragedFlag =\nFED Leveraged High Risk;
                  else (no)
                    if (goRaFedLeverageRatio >= goRaThresholdPerPolicyBasedOnSector) then (yes)
                      :fedLeveragedFlag =\nFED Leveraged High Risk;
                    else (no)
                      :fedLeveragedFlag =\nFED Leveraged Low Risk;
                    endif
                  endif
                endif
              endif
            endif
          else (no)
            :fedLeveragedFlag =\nFED not Leveraged;
          endif
